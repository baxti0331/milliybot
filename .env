# ============================================================
# Majburiy sozlamalar
# ============================================================

# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=

# Adminlarning Telegram ID raqamlari, vergul bilan ajratiladi (masalan: 123456789,987654321)
ADMIN_IDS=

# ============================================================
# Telegram akkauntlarni ulash uchun (my.telegram.org dan olinadi)
# Bo'sh bo'lsa, yangi akkaunt qo'shish ishlamaydi
# ============================================================

# Telegram API ID (raqam)
API_ID=
# Telegram API HASH
API_HASH=

# ============================================================
# Ixtiyoriy sozlamalar
# ============================================================

# Doimiy ma'lumotlar (baza, sessiyalar) saqlanadigan papka.
# Botxona buni o'zi beradi; kompyuteringizda sinash uchun ./data qoldiring
DATA_DIR=./data

# Efir manzili (sahifa havolasi). Bo'sh qoldirsangiz, botning o'zida kiritiladi
SOURCE_URL=

# Sayt cookie qiymatlari (ixtiyoriy, bot ichidan ham o'zgartiriladi)
ITV_COOKIES=

# Sayt Bearer tokeni (ixtiyoriy, bot ichidan ham o'zgartiriladi)
ITV_BEARER_TOKEN=

# Proksi manzili (masalan: http://user:parol@host:port). Bo'sh bo'lsa, proksisiz ishlaydi
PROXY_URL=

# Kadrlarni tekshirish oralig'i, soniyada (standart: 2)
FRAME_INTERVAL=2

# Bitta foydalanuvchi qo'sha oladigan maksimal akkauntlar soni (standart: 2)
MAX_ACCOUNTS_PER_USER=2

# Oddiy foydalanuvchilar o'zi ro'yxatdan o'tishiga ruxsat: 1 - ha, 0 - yo'q (standart: 1)
ALLOW_USER_SIGNUP=1

# OpenCV uchun FFmpeg parametrlari. Odatda bot o'zi o'rnatadi, tegmasangiz ham bo'ladi
OPENCV_FFMPEG_CAPTURE_OPTIONS=

# Ixtiyoriy: Telegram API manzili. Botxona proksisi uchun odatda kerak emas
TELEGRAM_API_URL=
